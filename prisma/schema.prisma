generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  weightKg        Float?
  heightCm        Float?
  birthDate       String? // ISO date YYYY-MM-DD
  gender          String? // male | female
  activityLevel   String? // sedentary | light | moderate | active | very_active

  foods        Food[]
  meals        MealEntry[]
  dailyTargets DailyTarget[]
}

model Food {
  id                  String  @id @default(uuid())
  name                String
  nameUk              String?
  caloriesPer100g     Float
  proteinPer100g      Float   @default(0)
  carbsPer100g        Float   @default(0)
  fatPer100g          Float   @default(0)
  fiberPer100g        Float   @default(0)
  sugarPer100g        Float   @default(0)
  saturatedFatPer100g Float   @default(0)
  saltPer100g         Float   @default(0)
  barcode             String?
  brand               String?
  category            String?
  source              String  @default("local") // local | openfoodfacts
  isDefault           Boolean @default(false)
  isPublic            Boolean @default(false)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meals MealEntry[]

  @@index([isDefault])
  @@index([isPublic])
  @@index([barcode])
}

model MealEntry {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodId             String
  food               Food     @relation(fields: [foodId], references: [id], onDelete: Restrict)
  quantityGrams      Float
  mealDate           String
  mealType           String // breakfast | lunch | dinner | snack
  calculatedCalories Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, mealDate])
}

model DailyTarget {
  id             String @id @default(uuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetDate     String
  targetCalories Float

  // Macronutrient targets (optional): protein/carbs/fat as % of calories, fiber goal in g, salt limit in g
  proteinPct Float?
  carbsPct   Float?
  fatPct     Float?
  fiberGrams         Float?
  saltGrams          Float?
  sugarGrams         Float?
  saturatedFatGrams  Float?

  // Target mode per metric: min | exact | max (JSON object, e.g. {"protein":"min","salt":"max"})
  modes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, targetDate])
}

// Written by the audit_row_deletes() trigger on every DELETE against
// user-data tables. Declared here so `migrate dev` does not flag it as
// drift; it is never queried through Prisma by the app.
model DeleteAudit {
  id              Int       @id @default(autoincrement())
  tableName       String    @map("tableName")
  rowCount        Int       @map("rowCount")
  deletedAt       DateTime  @default(now()) @db.Timestamptz(3) @map("deletedAt")
  applicationName String?   @map("applicationName")
  clientAddr      String?   @map("clientAddr")
  dbUser          String?   @map("dbUser")
  sessionUser     String?   @map("sessionUser")

  @@map("_DeleteAudit")
}
